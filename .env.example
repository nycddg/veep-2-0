# Copy to .env for local dev. On Vercel: Project Settings → Environment Variables.
# Publishable key is safe for the browser; never put service-role in VITE_*.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only (admin / RLS bypass). Set in Vercel, never VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Vite client bake-time (same values as above for the public ones)
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
